#!/data/data/com.termux/files/usr/bin/python3
import sys
import os
import re
import tempfile

def translate_line(line):
    stripped = line.strip()
    
    # Ignore comments and empty lines
    if not stripped or stripped.lower().startswith(("@echo off", "rem", "::")):
        return ""
    
    # Translate ECHO commands
    if re.match(r"^echo\s+", stripped, re.IGNORECASE):
        msg = re.sub(r"^echo\s+", "", stripped, flags=re.IGNORECASE)
        # Convert Windows %random% to Bash $RANDOM
        msg = re.sub(r"%random%", "$RANDOM", msg, flags=re.IGNORECASE)
        return f'echo "{msg}"'
        
    return f'# [Unparsed BAT]: {stripped}'

def main():
    if len(sys.argv) < 2:
        print("Usage: batbinexe <script.bat>")
        sys.exit(1)
        
    bat_file = sys.argv[1]
    if not os.path.exists(bat_file):
        print(f"Error: File '{bat_file}' not found.")
        sys.exit(1)
        
    with open(bat_file, "r", encoding="utf-8", errors="ignore") as f:
        bat_content = f.read()
        
    bash_lines = [
        "#!/data/data/com.termux/files/usr/bin/bash",
        "# Generated by batbinexe"
    ]
    
    for line in bat_content.splitlines():
        translated = translate_line(line)
        if translated:
            bash_lines.append(translated)
            
    # Write to a temporary shell script
    with tempfile.NamedTemporaryFile(mode="w", suffix=".sh", delete=False) as temp_sh:
        temp_sh.write("\n".join(bash_lines))
        temp_sh_path = temp_sh.name
        
    try:
        os.chmod(temp_sh_path, 0o755)
        os.system(f"bash {temp_sh_path}")
    finally:
        if os.path.exists(temp_sh_path):
            os.remove(temp_sh_path)

if __name__ == "__main__":
    main()
